# ===== 物业不动产租赁管理系统 · 云端环境变量模板 =====
# 用法：复制本文件为 .env 后填值   cp .env.example .env
# 注意：.env 含真实密码，已被 .gitignore 排除，切勿提交到 Git。
# 部署到 Netlify 时，这些值填到 Site settings → Environment variables，
# Functions 运行时只读控制台变量，不读本文件。

# ---------- 数据库（必填）----------
# TiDB Cloud Serverless 连接串，形如：
# mysql://<前缀>.root:<密码>@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/property
# 用户名必须是 <前缀>.root 格式（如 abc123xyz.root），否则会报 "Missing user name prefix"。
# 建议在 TiDB Cloud 上单独建一个 database（库名 property），与采购系统隔离。
DATABASE_URL=

# ---------- 登录 token 签名密钥（强烈建议自定义）----------
# 留空则使用内置演示密钥（不安全：任何人都可伪造登录 token）。
# 生产环境请填一段随机字符串，例如： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ---------- 附件存储（二选一）----------
# qiniu = 七牛云对象存储（推荐：文件持久、可公网访问、跨重启不丢）
# local = 写本机/容器磁盘 uploads/（Serverless 本地磁盘重启即丢，附件会全部失效）
ATT_STORAGE=qiniu

# 七牛云配置（仅当 ATT_STORAGE=qiniu 时必填，可复用采购系统的同一空间）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=            # 空间域名，不含 https://，例如 xxxx.bkt.clouddn.com
QINIU_REGION=z2          # 存储区域：z0=华东 z1=华北 z2=华南 na0=北美 as0=新加坡
QINIU_PRIVATE=           # 私有桶填 1；公开桶留空（走签名 URL 预览）
QINIU_URL_EXPIRE=3600    # 私有桶签名 URL 有效期（秒），默认 3600

# ---------- 本地开发（netlify dev 时用）----------
# 存储层：local=本地 json（默认） / cloud=TiDB
DB_MODE=local
PORT=8080